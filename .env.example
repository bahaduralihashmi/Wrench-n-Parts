# Database (DB_* or MYSQL* accepted)
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Application
SITE_URL=
FRONTEND_URL=
API_BASE_URL=
SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# Gemini AI (chatbot) - optional; chatbot falls back to KB-only if missing
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Storage (STORAGE_PROVIDER = local | s3)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=backend/uploads
STORAGE_PUBLIC_PREFIX=/uploads

# S3-compatible (Cloudflare R2, AWS S3, Supabase S3, etc.)
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_URL=

# Misc
MAINTENANCE_MODE=0
